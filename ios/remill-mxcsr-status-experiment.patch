+// Prototype for masked scalar 32-bit arithmetic only. Guest loads reject
+// DAZ, FTZ and unmasked exceptions before reaching the fixture.
+ALWAYS_INLINE static bool DcpDenormal32(float32_t lhs, float32_t rhs, bool divide) {
+  uint32_t l, r;
+  __builtin_memcpy(&l, &lhs, sizeof(l));
+  __builtin_memcpy(&r, &rhs, sizeof(r));
+  l &= 0x7fffffffu; r &= 0x7fffffffu;
+  const bool ld = l && l < 0x00800000u;
+  const bool rd = r && r < 0x00800000u;
+  if (l > 0x7f800000u || r > 0x7f800000u || (divide && ld && !r))
+    return false;
+  return ld || rd;
+}
+
+// Signaling NaNs require invalid status even when the NaN result helper
+// selects a quieted payload without performing host floating point arithmetic.
+ALWAYS_INLINE static bool DcpSignalingNaN32(float32_t value) {
+  uint32_t bits;
+  __builtin_memcpy(&bits, &value, sizeof(bits));
+  bits &= 0x7fffffffu;
+  return bits > 0x7f800000u && bits < 0x7fc00000u;
+}
