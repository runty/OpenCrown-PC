+namespace {
+template <typename D, typename S>
+DEF_SEM(RSQRTPS, D dst, S src) {
+  auto input = UReadV32(src);
+  auto result = UClearV32(UReadV32(dst));
+  _Pragma("unroll") for (size_t i = 0; i < NumVectorElems(input); ++i) {
+    union { uint32_t bits; float value; } lane;
+    lane.bits = UExtractV32(input, i);
+    const uint32_t sign = lane.bits & 0x80000000u;
+    const uint32_t exponent = lane.bits & 0x7f800000u;
+    const uint32_t mantissa = lane.bits & 0x007fffffu;
+    if (!exponent) lane.bits = sign | 0x7f800000u;
+    else if (exponent == 0x7f800000u && mantissa) lane.bits |= 0x00400000u;
+    else if (sign) lane.bits = 0xffc00000u;
+    else if (exponent == 0x7f800000u) lane.bits = 0;
+    else lane.value = FDiv(1.0f, __builtin_sqrtf(lane.value));
+    result = UInsertV32(result, i, lane.bits);
+  }
+  UWriteV32(dst, result);
+  return memory;
+}
+}
