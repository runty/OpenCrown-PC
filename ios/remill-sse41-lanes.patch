+namespace {
+template <typename D, typename S1, typename S2>
+DEF_SEM(BLENDPD, D dst, S1 src1, S2 src2, I8 immediate) {
+  auto first = UReadV64(src1);
+  auto second = UReadV64(src2);
+  auto result = UClearV64(UReadV64(dst));
+  auto mask = Read(immediate);
+  _Pragma("unroll") for (size_t i = 0; i < NumVectorElems(first); ++i) {
+    result = UInsertV64(result, i, (mask & (1u << i)) ? UExtractV64(second, i) : UExtractV64(first, i));
+  }
+  UWriteV64(dst, result);
+  return memory;
+}
+}
