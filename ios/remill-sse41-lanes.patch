+// OpenCrown: SSE4.1 lane insertion and immediate floating-point bit blends.
+namespace {
+template <typename D, typename S1, typename S2>
+DEF_SEM(INSERTPS, D dst, S1 src1, S2 src2, I8 immediate) {
+  auto result = UReadV32(src1);
+  auto second = UReadV32(src2);
+  auto control = Read(immediate);
+  const size_t source_lane = NumVectorElems(second) == 1 ? 0 : ((control >> 6) & 3);
+  result = UInsertV32(result, (control >> 4) & 3, UExtractV32(second, source_lane));
+  _Pragma("unroll") for (size_t i = 0; i < 4; ++i) {
+    if (control & (1u << i)) result = UInsertV32(result, i, 0_u32);
+  }
+  UWriteV32(dst, result);
+  return memory;
+}
+template <typename D, typename S1, typename S2>
+DEF_SEM(BLENDPS, D dst, S1 src1, S2 src2, I8 immediate) {
+  auto first = UReadV32(src1);
+  auto second = UReadV32(src2);
+  auto result = UClearV32(UReadV32(dst));
+  auto mask = Read(immediate);
+  _Pragma("unroll") for (size_t i = 0; i < NumVectorElems(first); ++i) {
+    result = UInsertV32(result, i, (mask & (1u << i)) ? UExtractV32(second, i) : UExtractV32(first, i));
+  }
+  UWriteV32(dst, result);
+  return memory;
+}
+}
